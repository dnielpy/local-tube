POSTGRES_USER=localtube
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=localtube

# Folder on the external hard drive where the videos are saved. It must exist and be mounted
# before starting the containers, for example /mnt/disco/localtube or /media/pi/Disco/localtube.
MEDIA_PATH=/mnt/disco/localtube

# Ports on the host: the web at http://<ip of the host>:WEB_PORT, the api alone at API_PORT
WEB_PORT=3004
API_PORT=3005

DOWNLOAD_CONCURRENCY=1
DEFAULT_MAX_HEIGHT=360

TZ=America/Havana
