# Each profile's YouTube cookies are kept in PROFILES_ROOT/<profile id>/cookies.txt.
PROFILES_ROOT=../../config/profiles

DEFAULT_MAX_HEIGHT=360

# Downloads only run between these hours; the same value for both lets them run at any hour.
DOWNLOAD_WINDOW_START=00:00
DOWNLOAD_WINDOW_END=00:00

# Lets the home server dashboard read /api/stats with the X-Service-Token header.
SERVICE_TOKEN=
