# Local development settings, read by the api from apps/api/.env.
# DATABASE_URL=postgresql+asyncpg://localtube:localtube@localhost:5442/localtube
# MEDIA_ROOT=./media

# YouTube cookies: read them straight from a browser installed on this machine
# (chrome, firefox, safari, brave, edge...) or point to an exported cookies.txt.
COOKIES_FROM_BROWSER=chrome
# COOKIES_FILE=./cookies.txt

DEFAULT_MAX_HEIGHT=360
