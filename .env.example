# Copy to .env and adjust for the server.
POSTGRES_USER=localtube
POSTGRES_PASSWORD=change-me
POSTGRES_DB=localtube

# Folder on the hard drive where videos and thumbnails are stored.
MEDIA_PATH=/mnt/disco/localtube

# Port LocalTube is served on in the local network.
PORT=80

# How many videos download at the same time.
DOWNLOAD_CONCURRENCY=1

# Default quality cap in pixels of height (the downloads page can pick another one).
DEFAULT_MAX_HEIGHT=360

# YouTube cookies exported from a logged-in browser, saved as ./config/cookies.txt.
# Needed when YouTube answers "Sign in to confirm you're not a bot".
# COOKIES_FILE=/config/cookies.txt
